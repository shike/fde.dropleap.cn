# nginx 反代模板：复制到 /etc/nginx/sites-available/ 并替换 fde.example.cn 为你的域名
# sudo ln -s /etc/nginx/sites-available/fde.conf /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# HTTPS：sudo certbot --nginx -d fde.example.cn

server {
    listen 80;
    server_name fde.example.cn;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # 建议先全站 robots 屏蔽验收，正式上线再放开
    # location /robots.txt { return 200 "User-agent: *\nDisallow: /\n"; }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
